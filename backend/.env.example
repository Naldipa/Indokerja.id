# Supabase Session pooler: use port 5432 and percent-encode reserved password characters.
DATABASE_URL="postgresql://postgres.<project-ref>:<YOUR-PASSWORD>@<pooler-host>:5432/postgres?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret-at-least-24-chars"
PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"
SESSION_COOKIE_SAME_SITE=lax
